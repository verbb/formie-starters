{
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "craftcms/cms": "^5.10.0",
    "dompdf/dompdf": "3.1.6 as 2.0.9",
    "openspout/openspout": "^4.28.5",
    "putyourlightson/craft-datastar": "^1.0@RC",
    "putyourlightson/craft-sprig": "dev-develop",
    "verbb/auth": "^2.0.48",
    "verbb/base": "^3.0.20",
    "verbb/formie": "dev-beta as 4.0.0-beta.1",
    "verbb/tiptap": "^1.0.3",
    "vlucas/phpdotenv": "^5.4.0"
  },
  "require-dev": {
    "craftcms/generator": "^2.0.0",
    "yiisoft/yii2-shell": "^2.0.3"
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example.dev', '.env');\""
    ]
  }
}
