<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover">
    <title>{{ pageTitle ?? 'Formie Craft Starters' }}</title>
    <meta name="referrer" content="origin-when-cross-origin">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style type="text/tailwindcss">
        @layer theme, base, components, utilities;

        @layer base {
            html {
                color-scheme: light;
            }

            body {
                @apply m-0 min-h-screen bg-[#eef0f4] text-slate-900 antialiased;
            }

            a {
                @apply text-inherit no-underline;
            }

            button,
            input,
            select,
            textarea {
                font: inherit;
            }
        }

        @layer components {
            .starter-surface {
                @apply rounded-[28px] border border-slate-200 bg-white shadow-[0_18px_40px_-34px_rgba(15,23,42,0.2)];
            }

            .starter-choice-card {
                @apply block w-full rounded-2xl border border-slate-200 bg-white p-5 text-left transition hover:border-slate-300 hover:bg-slate-50/80;
            }

            .starter-choice-card.is-active {
                @apply border-violet-200 bg-violet-50/70 shadow-[inset_0_0_0_1px_rgba(196,181,253,0.35)];
            }

            .starter-form-wrap {
                @apply rounded-3xl border border-slate-200 bg-white p-5 shadow-[0_18px_40px_-34px_rgba(15,23,42,0.2)];
            }

            .starter-demo-copy {
                @apply text-sm leading-6 text-slate-500;
            }

            .starter-platform-mark {
                @apply inline-flex h-11 w-11 items-center justify-center rounded-2xl text-sm font-semibold text-white shadow-sm;
            }

            .starter-link-button {
                @apply inline-flex items-center justify-center rounded-xl bg-violet-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-violet-700;
            }
        }
    </style>
    {% block head %}{% endblock %}
</head>
<body>
<svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="hidden absolute h-0 w-0 overflow-hidden">
    <symbol viewBox="0 0 32 32" id="barba-b" xmlns="http://www.w3.org/2000/svg">
        <defs>
            <path d="M8 10c-4.418 0-8 3.59-8 8 0 4.418 3.59 8 8 8H0V0h8v10z" id="ca"></path>
        </defs>
        <g fill-rule="evenodd">
            <use stroke-width="2" xlink:href="#ca" transform="translate(9.5 3)"></use>
            <path d="M9.5 21c0 4.418 3.59 8 8 8h0c4.418 0 8-3.59 8-8h0c0-4.418-3.59-8-8-8h0c-4.418 0-8 3.59-8 8h0z" stroke-width="2"></path>
        </g>
    </symbol>
</svg>
{% block page %}{% endblock %}
</body>
</html>
