# Copy to `.env.local` and point at your Craft site (ddev example below).
# Browsers call this origin directly; ensure Craft allows your starter origin in CORS if needed.
NEXT_PUBLIC_FORMIE_BASE_URL=https://craft.ddev.site

# Optional when GraphQL is not at {base}/api
# NEXT_PUBLIC_FORMIE_GRAPHQL_ENDPOINT=https://craft.ddev.site/api

NEXT_PUBLIC_FORMIE_SINGLE_PAGE_HANDLE=singlePage
NEXT_PUBLIC_FORMIE_MULTI_PAGE_HANDLE=multiPage
NEXT_PUBLIC_FORMIE_ADVANCED_HANDLE=advanced
