# Copy to `.env` and point at your Craft site (ddev example below).
# Browsers call this origin directly; ensure Craft allows your starter origin in CORS if needed.
NUXT_PUBLIC_FORMIE_BASE_URL=https://craft.ddev.site

# Optional when GraphQL is not at {base}/api
# NUXT_PUBLIC_FORMIE_GRAPHQL_ENDPOINT=https://craft.ddev.site/api

NUXT_PUBLIC_FORMIE_SINGLE_PAGE_HANDLE=singlePage
NUXT_PUBLIC_FORMIE_MULTI_PAGE_HANDLE=multiPage
NUXT_PUBLIC_FORMIE_ADVANCED_HANDLE=advanced
