# Copy to `.env` and point at your Craft site (ddev example below).
# Browsers call this origin directly; ensure Craft allows your starter origin in CORS if needed.
VITE_FORMIE_BASE_URL=https://craft.ddev.site:8443

# Optional when GraphQL is not at {base}/api
# VITE_FORMIE_GRAPHQL_ENDPOINT=https://craft.ddev.site:8443/api

VITE_FORMIE_SINGLE_PAGE_HANDLE=singlePage
VITE_FORMIE_MULTI_PAGE_HANDLE=multiPage
VITE_FORMIE_ADVANCED_HANDLE=advanced
